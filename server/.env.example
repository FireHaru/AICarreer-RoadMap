# Port for the API server
PORT=4000

# REQUIRED in production. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Leave empty to use the embedded PostgreSQL (PGlite) stored in server/data/.
# Set to use a real PostgreSQL server, e.g. postgres://user:pass@localhost:5432/pathforge
DATABASE_URL=

# Optional: PathGPT uses a built-in reasoning engine by default.
# Set one of these to let an LLM write the answers (the roadmap engine stays deterministic).
AI_PROVIDER=        # gemini | openai | (empty = local)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Password-reset links are returned in the API response while there is no mail service.
# Defaults to true outside production.
EXPOSE_RESET_TOKEN=
